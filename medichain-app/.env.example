APP_ENV=development            # production => JWT_SECRET wajib, /docs mati, HSTS aktif
DATABASE_URL=postgresql+psycopg://medichain:ganti-password@localhost:5433/medichain
JWT_SECRET=                    # isi: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:8000
# Local Next.js dev server on port 3000 can proxy to Docker API exposed at 8001.
API_ORIGIN=http://127.0.0.1:8001
# Pilih tepat satu mode; ubah nilai ini lalu restart backend.
# mock = ledger simulasi lokal. web3 = transaksi publik Sepolia (test ETH tetap dibelanjakan).
CHAIN_MODE=mock                # mock | web3
# Isi variabel berikut hanya ketika CHAIN_MODE=web3. Jangan menaruh rahasia di Git.
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
BLOCK_EXPLORER_TX_BASE=https://sepolia.etherscan.io/tx/
# --- hanya untuk CHAIN_MODE=web3 (akun TESTNET khusus, jangan pernah dana nyata) ---
RPC_URL=
CONTRACT_ADDRESS=
CHAIN_PRIVATE_KEY=
ENABLE_TAMPER_SIM=false        # true hanya untuk demo; ditolak di production
POSTGRES_PASSWORD=ganti-password
SEED_PASSWORD=
# Email OTP patient registration is temporarily disabled; keep false unless deliberately re-enabled.
ENABLE_EMAIL_OTP_REGISTRATION=false
# SMTP settings are only used if email OTP registration is re-enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
OTP_SECRET=                   # use a separate random secret in production
# Google Identity Services (same OAuth Web client ID for backend and Next.js)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
